+/* True when the active decoder GUID is one of the HEVC Range Extensions
+ * 4:4:4 profiles, which require the extended picture parameter structure. */
+static int hevc_dxva_uses_range_ext(const AVCodecContext *avctx)
+{
+    FFDXVASharedContext *sctx = DXVA_SHARED_CONTEXT(avctx);
+    return IsEqualGUID(&sctx->decoder_guid, &ff_DXVA2_ModeHEVC_VLD_Main10_444) ||
+           IsEqualGUID(&sctx->decoder_guid, &ff_DXVA2_ModeHEVC_VLD_Main_444);
+}
+
+/* Append the Range Extensions tail (DXVA spec RExt picture parameters) to an
+ * already-filled base structure. Every field mirrors the SPS/PPS range
+ * extension syntax; FFmpeg keeps them flattened on HEVCSPS/HEVCPPS. */
+static void ff_dxva2_hevc_fill_range_extensions(const AVCodecContext *avctx,
+                                                DXVA_PicParams_HEVC_RangeExt *pp)
+{
+    const HEVCContext *h = avctx->priv_data;
+    const HEVCPPS *pps = h->pps;
+    const HEVCSPS *sps;
+
+    if (!pps || !(sps = pps->sps))
+        return;
+    pp->dwRangeExtensionFlags =
+        ((unsigned)sps->transform_skip_rotation_enabled         <<  0) |
+        ((unsigned)sps->transform_skip_context_enabled          <<  1) |
+        ((unsigned)sps->implicit_rdpcm_enabled                  <<  2) |
+        ((unsigned)sps->explicit_rdpcm_enabled                  <<  3) |
+        ((unsigned)sps->extended_precision_processing           <<  4) |
+        ((unsigned)sps->intra_smoothing_disabled                <<  5) |
+        ((unsigned)sps->persistent_rice_adaptation_enabled      <<  6) |
+        ((unsigned)sps->high_precision_offsets_enabled          <<  7) |
+        ((unsigned)sps->cabac_bypass_alignment_enabled          <<  8) |
+        ((unsigned)pps->cross_component_prediction_enabled_flag <<  9) |
+        ((unsigned)pps->chroma_qp_offset_list_enabled_flag      << 10);
+    pp->diff_cu_chroma_qp_offset_depth = pps->diff_cu_chroma_qp_offset_depth;
+    pp->log2_sao_offset_scale_luma     = pps->log2_sao_offset_scale_luma;
+    pp->log2_sao_offset_scale_chroma   = pps->log2_sao_offset_scale_chroma;
+    /* FFmpeg stores log2_max_transform_skip_block_size with the +2 bias. */
+    pp->log2_max_transform_skip_block_size_minus2 =
+        (UCHAR)(pps->log2_max_transform_skip_block_size - 2);
+    memcpy(pp->cb_qp_offset_list, pps->cb_qp_offset_list,
+           sizeof(pp->cb_qp_offset_list));
+    memcpy(pp->cr_qp_offset_list, pps->cr_qp_offset_list,
+           sizeof(pp->cr_qp_offset_list));
+    pp->chroma_qp_offset_list_len_minus1 = pps->chroma_qp_offset_list_len_minus1;
+}
